# ── Application ───────────────────────────────────────────────────────────────
BASE_URL=https://qacart-todo.herokuapp.com
HEADLESS=false
BROWSER=chromium

# Groq : fournisseur unique. Quotas et facturation selon le compte.
# Créer une clé sur https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
RAG_ENABLED=true
RAG_MODE=bm25

# Dedicated test data database. Run npm run data:setup for an isolated local instance.
TEST_DATA_PROVIDER=memory
TEST_DATA_PGHOST=127.0.0.1
TEST_DATA_PGPORT=5433
TEST_DATA_PGDATABASE=qa_test_data
TEST_DATA_PGUSER=qa_data
TEST_DATA_PGPASSWORD=
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=openai/gpt-oss-20b
RAG_RERANK_CANDIDATES=12
RAG_RERANK_STRICT=false
GROQ_MODEL=openai/gpt-oss-120b
NODE_TLS_REJECT_UNAUTHORIZED=1



# DEEPEVAL_JUDGE_PROVIDER=groq
# DEEPEVAL_JUDGE_MODEL=openai/gpt-oss-120b
# Maximum logical judge calls per evaluation; default 30.
DEEPEVAL_MAX_JUDGE_CALLS=30
PLANE_WORKSPACE=ai-qa-automation
PLANE_PROJECT_ID=a1cd9e82-915a-4dc9-9fd9-69441c41ebdb
PLANE_API_KEY=
# Synchronize dated Allure results after runs started through runner-agent.
PLANE_SYNC_RESULTS=false
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_RAG_ENABLED=false
# Optional trusted CA bundle, TLS verification stays enabled.
CONFLUENCE_CA_FILE=
DEEPEVAL_JUDGE_PROVIDER=groq
